# Get these from business-dev.blaaiz.com → API & Webhooks (sign up there first).
# OAuth (recommended — this is what new accounts get). client_secret is shown
# once when you create it, so copy it somewhere safe right away.
BLAAIZ_CLIENT_ID=
BLAAIZ_CLIENT_SECRET=

# Legacy fallback — only set this if your account was issued a raw API key
# instead of OAuth credentials. Leave blank if you have CLIENT_ID/SECRET above.
BLAAIZ_API_KEY=

BLAAIZ_API_URL=https://api-dev.blaaiz.com
BLAAIZ_WALLET_ID=
